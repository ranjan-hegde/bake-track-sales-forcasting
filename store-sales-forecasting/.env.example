# Copy to `.env` and adjust as needed. Loaded automatically if python-dotenv is installed.

# Where trained artifacts (models, scaler, encoders, metadata) live.
ARTIFACTS_DIR=artifacts

# Default model when the caller doesn't specify one: "lgbm" or "svr".
DEFAULT_MODEL=lgbm

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# API bind address/port (used by uvicorn in the Dockerfile / your run command).
API_HOST=0.0.0.0
API_PORT=8000

# OPTIONAL: if set, every /predict and /compare call must send header `x-api-key: <value>`.
# Leave unset for open local/dev access. SET THIS for any public deployment.
# API_KEY=change-me
